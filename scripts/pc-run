#!/usr/bin/env python3
"""
pc-run: Zero-dependency phone-side CLI executor for Classroom USB Bridge (127.0.0.1:19999).

Works inside any mobile AI Agent runtime (Operit PRoot, DSH-Go, Termux, Claude Code, Antigravity).
- Wraps PowerShell commands in UTF-8 Base64 so quotes, `$variables`, MySQL `DELIMITER $$`,
  newlines, and CJK text execute 100% losslessly on Windows without CP936 quote-swallowing.
- Supports binary file push (`--push`, zero UTF-8 BOM) and pull (`--pull`, zero Base64 stdout bloat
  + automatic JPEG/PNG magic-byte integrity verification).

Usage:
  pc-run "<powershell_command>" [optional_cwd]
  pc-run --ping
  pc-run --push <local_phone_path> <remote_pc_path>
  pc-run --pull <remote_pc_path> <local_phone_path>
"""

import base64
import json
import os
import pathlib
import sys
import urllib.error
import urllib.request

DEFAULT_HOST = os.environ.get("PC_BRIDGE_HOST", "127.0.0.1")
DEFAULT_PORT = int(os.environ.get("PC_BRIDGE_PORT", "19999"))
DEFAULT_CWD = os.environ.get("PC_BRIDGE_CWD", "D:\\")
DEFAULT_TIMEOUT = float(os.environ.get("PC_BRIDGE_TIMEOUT", "120"))


def base_url() -> str:
    return f"http://{DEFAULT_HOST}:{DEFAULT_PORT}"


def print_conn_hint(err: Exception) -> None:
    sys.stderr.write(f"[pc-run] Cannot reach Classroom PC USB Bridge ({base_url()}): {err}\n")
    sys.stderr.write(
        "Checklist:\n"
        "  1. Connect phone to PC via USB cable (enable File Transfer / MTP + USB Debugging).\n"
        "  2. On PC, double-click 'D:\\Classroom_USB_Kit\\1_开启电脑被控桥(插线双击即可).bat' (or 'start_bridge.bat').\n"
    )


def verify_image_magic(path: pathlib.Path, data: bytes) -> None:
    ext = path.suffix.lower()
    if ext in (".jpg", ".jpeg"):
        if len(data) < 4 or data[:2] != b"\xff\xd8" or data[-2:] != b"\xff\xd9":
            raise ValueError(
                f"Corrupted JPEG payload ({len(data)} bytes): missing FFD8..FFD9 magic bytes"
            )
    elif ext == ".png":
        if len(data) < 16 or data[:8] != b"\x89PNG\r\n\x1a\n":
            raise ValueError(
                f"Corrupted PNG payload ({len(data)} bytes): missing 89504E47 magic header"
            )


def cmd_ping() -> int:
    req = urllib.request.Request(f"{base_url()}/ping", method="GET")
    try:
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            sys.stdout.write(f"[pc-run] OK: {res.get('stdout', 'pong').strip()} (cwd={res.get('cwd', '')})\n")
            return 0
    except urllib.error.URLError as e:
        print_conn_hint(e)
        return 2


def cmd_push(local_path_str: str, remote_path_str: str) -> int:
    local_path = pathlib.Path(local_path_str)
    if not local_path.is_file():
        sys.stderr.write(f"[pc-run] Local file not found: {local_path}\n")
        return 1
    raw = local_path.read_bytes()
    # Strip accidental UTF-8 BOM when pushing .py or .sql scripts unless explicitly binary
    if local_path.suffix.lower() in (".py", ".sql") and raw.startswith(b"\xef\xbb\xbf"):
        raw = raw[3:]
    b64_target = base64.b64encode(remote_path_str.encode("utf-8")).decode("ascii")
    req = urllib.request.Request(
        f"{base_url()}/push",
        data=raw,
        headers={
            "Content-Type": "application/octet-stream",
            "X-Target-Path-B64": b64_target,
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=DEFAULT_TIMEOUT) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            if not res.get("ok"):
                sys.stderr.write(f"[pc-run] Push failed: {res.get('stderr', 'unknown error')}\n")
                return int(res.get("exit_code", 1) or 1)
            sys.stdout.write(f"[pc-run] Pushed {len(raw)} bytes -> {res.get('path', remote_path_str)}\n")
            return 0
    except urllib.error.URLError as e:
        print_conn_hint(e)
        return 2


def cmd_pull(remote_path_str: str, local_path_str: str) -> int:
    local_path = pathlib.Path(local_path_str)
    payload = json.dumps({"path": remote_path_str}).encode("utf-8")
    req = urllib.request.Request(
        f"{base_url()}/pull",
        data=payload,
        headers={"Content-Type": "application/json; charset=utf-8"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=DEFAULT_TIMEOUT) as resp:
            data = resp.read()
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")
        sys.stderr.write(f"[pc-run] Pull failed (HTTP {e.code}): {err_body}\n")
        return 1
    except urllib.error.URLError as e:
        print_conn_hint(e)
        return 2

    try:
        verify_image_magic(local_path, data)
    except ValueError as ve:
        sys.stderr.write(f"[pc-run] Integrity check failed: {ve}\n")
        return 3

    local_path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = local_path.with_suffix(local_path.suffix + ".part")
    tmp_path.write_bytes(data)
    tmp_path.replace(local_path)
    sys.stdout.write(f"[pc-run] Pulled {len(data)} bytes -> {local_path}\n")
    return 0


def cmd_exec(raw_cmd: str, cwd: str) -> int:
    full_ps = (
        "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; "
        "$OutputEncoding = [System.Text.Encoding]::UTF8; "
        f"{raw_cmd}"
    )
    b64 = base64.b64encode(full_ps.encode("utf-8")).decode("ascii")
    safe_cmd = (
        "Invoke-Expression ([System.Text.Encoding]::UTF8.GetString("
        f"[System.Convert]::FromBase64String('{b64}')))"
    )

    payload = json.dumps({"cmd": safe_cmd, "cwd": cwd, "preview": raw_cmd[:120]}).encode("utf-8")
    req = urllib.request.Request(
        f"{base_url()}/exec",
        data=payload,
        headers={"Content-Type": "application/json; charset=utf-8"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=DEFAULT_TIMEOUT) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            stdout = res.get("stdout") or ""
            stderr = res.get("stderr") or ""
            if stdout:
                sys.stdout.write(stdout)
                if not stdout.endswith("\n"):
                    sys.stdout.write("\n")
            if stderr:
                sys.stderr.write(stderr)
                if not stderr.endswith("\n"):
                    sys.stderr.write("\n")
            return int(res.get("exit_code", 0) or 0)
    except urllib.error.URLError as e:
        print_conn_hint(e)
        return 2


def usage() -> None:
    sys.stderr.write(
        "Usage:\n"
        "  pc-run '<powershell_command>' [optional_cwd]\n"
        "  pc-run --ping\n"
        "  pc-run --push <local_phone_file> <remote_pc_path>\n"
        "  pc-run --pull <remote_pc_path> <local_phone_file>\n"
    )


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        usage()
        sys.exit(0 if args else 1)

    if args[0] == "--ping":
        sys.exit(cmd_ping())
    if args[0] == "--push":
        if len(args) != 3:
            usage()
            sys.exit(1)
        sys.exit(cmd_push(args[1], args[2]))
    if args[0] == "--pull":
        if len(args) != 3:
            usage()
            sys.exit(1)
        sys.exit(cmd_pull(args[1], args[2]))

    raw_cmd = args[0]
    cwd = args[1] if len(args) > 1 else DEFAULT_CWD
    sys.exit(cmd_exec(raw_cmd, cwd))


if __name__ == "__main__":
    main()
